name: Build Flipper app

on:
  push:
    branches: [ main ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install ufbt
        run: pip install ufbt

      - name: Build
        run: ufbt

      - name: Upload fap
        uses: actions/upload-artifact@v4
        with:
          name: night_shift-fap
          path: dist/*.fap
